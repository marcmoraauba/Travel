# Copia este archivo a .env.local y rellénalo. Para builds de EAS, crea las mismas variables
# con `npx eas-cli@latest env:create` (entorno development / preview / production).

# URL del Worker de Cloudflare desplegado desde backend/ (sin barra final).
EXPO_PUBLIC_API_URL=https://travel-api.<tu-subdominio>.workers.dev

# Token PÚBLICO de Mapbox (empieza por pk.). Solo para pintar el mapa.
# El token secreto (sk.) va únicamente en el Worker.
EXPO_PUBLIC_MAPBOX_TOKEN=pk.xxxxx

# Opcional: debe coincidir con APP_KEY del Worker. No es un secreto real (va dentro de la app),
# solo corta el abuso casual del proxy.
EXPO_PUBLIC_APP_KEY=
